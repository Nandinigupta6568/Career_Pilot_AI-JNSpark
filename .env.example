# Required for full AI mode. Get a key from the ASI:One developer portal.
ASI_ONE_API_KEY=
ASI_ONE_BASE_URL=https://api.asi1.ai/v1
ASI_ONE_MODEL=asi1
ASI_ONE_TIMEOUT=45

# Required for a stable agent identity and Agentverse mailbox setup. Create your own
# private seed phrase; never share it or commit the real value to GitHub.
CAREERPILOT_AGENT_SEED=replace_with_your_own_private_seed_phrase
